DATABASE_URL=postgresql://user:password@localhost:5432/inventory_management
# Generate with: openssl rand -hex 32 (required; min 32 chars outside development)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=alerts@example.com
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
VITE_API_URL=http://localhost:8000

# docker-compose only (DATABASE_URL is rebuilt from these inside compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=inventory_management
